@using EnigmaStock.Models
@model PurchaseItem

<div class="container">
    <div class="row pt-4">
        <div class="col-6">
            <h2 class="text-primary">Edit Purchase Item</h2>

        </div>

    </div>
    <br />

    <form method="post">
        <input asp-for="Id" type="hidden"/>
        <input asp-for="PurchaseId" type="hidden"/>


        <div class="mb-3">
            <label asp-for="ProductId"></label>
            <select asp-for="ProductId" class="form-control">
                @foreach (var product in ViewBag.Products)
                        {
                            <option value="@product.Id">@product.Name

                            </option>
                        }

           </select>
           <span asp-validation-for="ProductId" class="text-danger"></span>

        </div>
        <div class="mb-3">
            <label asp-for="Quantity"></label>
            <input asp-for="Quantity" class="form-control" type="number" min="1" />
            <span asp-validation-for="Quantity" class="text-danger"></span>

        </div>

        <div class="mb-3">
            <label asp-for="CostPrice"></label>
            <input asp-for="CostPrice" class="form-control" type="number" min="0" step="0.01"/>
            <span asp-validation-for="CostPrice" class="text-danger"></span>

        </div>

        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-controller="Purchase" asp-action="Details" asp-route-id="@Model.PurchaseId">Back To Purchase</a>
    </form>



</div>