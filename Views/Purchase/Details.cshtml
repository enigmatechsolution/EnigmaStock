@using EnigmaStock.Models
@model Purchase

<div class="container">


    <div class="row pt-4">
        <div class="col-4">
            <h2 class="text-primary">Purchase Details</h2>

        </div>


        <div class="col-6 text-end"><a asp-controller="Purchase" asp-action="Index" class="btn btn-secondary">Back to List</a>

        </div>

    </div>
    <br />



    <div class="border p-3">

        <div class="row">


            <div class="col-4">
                <strong>Reference Number</strong>
                <p>@Model.ReferenceNumber</p>

            </div>

            <div class="col-4">
                <strong>Supplier</strong>
                <p>@Model.Supplier?.Name</p>

            </div>

            <div class="col-4">
                <strong>Purchase Date</strong>
                <p>@Model.PurchaseDate.ToString("dd/MM/yyyy")</p>

            </div>


        </div>


    </div>
    <br />

    <div class="row">
        <div class="col-6">
    <h4>Purchase Items</h4>
    </div>

    <div class="col-6 text-end"><a asp-controller="Purchase" asp-action="AddItem" asp-route-purchaseId="@Model.Id" class="btn btn-primary">Add Item

    </a>

    </div>
    </div>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Product</th>
                <th>Quantity</th>
                <th>Cost Price</th>
                <th>Total</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach(var item in Model.purchaseItems)
            {
                <tr>
                    <td>@item.product?.Name</td>
                    <td>@item.Quantity</td>
                    <td>₦@item.CostPrice.ToString("N2")</td>
                    <td>₦@((item.Quantity * item.CostPrice).ToString("N2"))</td>
                    <td><a asp-controller="Purchase" asp-action="EditItem" asp-route-id="@item.Id" class="btn btn-outline-primary">Edit</a>
                        <a asp-controller="Purchase" asp-action="DeleteItem" asp-route-id="@item.Id" class="btn btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>


    </table>


</div>