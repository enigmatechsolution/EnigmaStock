@using EnigmaStock.Models
@model List<Product>

    <div class="container p-3">

        <div class="rowpt-4">
            <div class="col-6">
                <h2 class="text-primary">Product List</h2>
            </div>

            <div class="col-6 text-end">
                <a asp-controller="Product" asp-action="Create" class="btn btn-primary">Create Product</a>

            </div>

        </div>
        <br />

        <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Product Name</th>
                <th>Category</th>
                <th>SKU</th>
                <th>CostPrice</th>
                <th>SellingPrice</th>
                <th>Quantity</th>
                <th>Reorder Level</th>
                <th>Stock Status</th>
                <th>Description</th>         
                <th>Actions</th>
            </tr>

        </thead>

        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.Category.Name</td>

                    <td>@product.SKU</td>
                    <td>&#8358;@product.CostPrice.ToString("N0")</td>
                    <td>&#8358;@product.SellingPrice.ToString("N0")</td>
                    <td>@product.Quantity</td>
                    <td>@product.ReorderLevel</td>
                    <td>
                        @if (product.Quantity <= product.ReorderLevel)
                        {
                            <span class="text-danger">Low Stock</span>
                        }
                        else
                        {
                            <span class="text-success">In Stock</span>
                        }

                    </td>
                    <td>@product.Description</td>
                    <td><a asp-controller="Product" asp-action="Edit" asp-route-id="@product.Id" class="btn btn-primary">Edit</a>
                        <a asp-controller="Product" asp-action="Delete" asp-route-id="@product.Id" class="btn btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
        </table>
    </div>