@using EnigmaStock.Models
@model Product

<form method="post">
    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2 class="text-primary">Delete Product</h2>
            <hr />

        </div>
        <input asp-for="Id" hidden />

        <div class="mb-3">
            <label asp-for="Name"></label>
            <input asp-for="Name" class="form-control" disabled />
            
        </div>


        <div class="mb-3">
            <label asp-for="SellingPrice"></label>  
             <input asp-for="SellingPrice" class="form-control" disabled/>
        </div>


     <h5>Are you sure you want to delete this product</h5>

    
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-controller="Product" asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>

</form>