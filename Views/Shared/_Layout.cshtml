<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - EnigmaStock</title>


    <!-- Bootstrap -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- AdminLTE -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/admin-lte@4.9.1/dist/css/adminlte.min.css" />


    <!-- Font Awesome -->

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />


    <!-- EnigmaStock CSS -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />


    <link rel="stylesheet"
          href="~/EnigmaStock.styles.css"
          asp-append-version="true" />

</head>


<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">


    <div class="app-wrapper">


        <!-- ================================================= -->
        <!-- HEADER / TOP NAVBAR -->
        <!-- ================================================= -->

        <nav class="app-header navbar navbar-expand bg-body">

            <div class="container-fluid">


                <!-- Left Side -->

                <ul class="navbar-nav">

                    <li class="nav-item">

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="nav-link">

                            <i class="fas fa-home me-1"></i>

                            <span>
                                Home
                            </span>

                        </a>

                    </li>

                </ul>


                <!-- Right Side -->

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">

                        <partial name="_LoginPartial" />

                    </li>

                </ul>


            </div>

        </nav>



        <!-- ================================================= -->
        <!-- SIDEBAR -->
        <!-- ================================================= -->

        <aside class="app-sidebar bg-dark shadow"
               data-bs-theme="dark">


            <!-- Brand -->

            <div class="sidebar-brand">

                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="brand-link">

                    <span class="brand-text fw-light">

                        EnigmaStock

                    </span>

                </a>

            </div>



            <!-- Sidebar Wrapper -->

            <div class="sidebar-wrapper">

                <nav class="mt-2">

                    <ul class="nav sidebar-menu flex-column"
                        data-lte-toggle="treeview"
                        role="menu">


                        <!-- ========================= -->
                        <!-- HOME -->
                        <!-- ========================= -->

                        <li class="nav-item">

                            <a asp-controller="Home"
                               asp-action="Index"
                               class="nav-link">

                                <i class="nav-icon fas fa-home"></i>

                                <p>
                                    Home
                                </p>

                            </a>

                        </li>



                        <!-- ========================= -->
                        <!-- DASHBOARD -->
                        <!-- ========================= -->

                        <li class="nav-item">

                            <a asp-controller="Dashboard"
                               asp-action="Index"
                               class="nav-link">

                                <i class="nav-icon fas fa-chart-line"></i>

                                <p>
                                    Dashboard
                                </p>

                            </a>

                        </li>



                        <!-- ========================= -->
                        <!-- INVENTORY -->
                        <!-- ========================= -->

                        <li class="nav-header">

                            INVENTORY

                        </li>



                        <!-- Products -->

                        <li class="nav-item">

                            <a asp-controller="Product"
                               asp-action="Index"
                               class="nav-link">

                                <i class="nav-icon fas fa-box"></i>

                                <p>
                                    Products
                                </p>

                            </a>

                        </li>



                        <!-- Categories -->

                        <li class="nav-item">

                            <a asp-controller="Category"
                               asp-action="Index"
                               class="nav-link">

                                <i class="nav-icon fas fa-tags"></i>

                                <p>
                                    Categories
                                </p>

                            </a>

                        </li>



                        <!-- Stock Movements -->

                        <li class="nav-item">

                            <a asp-controller="StockMovement"
                               asp-action="Index"
                               class="nav-link">

                                <i class="nav-icon fas fa-right-left"></i>

                                <p>
                                    Stock Movements
                                </p>

                            </a>

                        </li>



                        <!-- ========================= -->
                        <!-- PROCUREMENT -->
                        <!-- ========================= -->

                        <li class="nav-header">

                            PROCUREMENT

                        </li>



                        <!-- Suppliers -->

                        <li class="nav-item">

                            <a asp-controller="Supplier"
                               asp-action="Index"
                               class="nav-link">

                                <i class="nav-icon fas fa-truck"></i>

                                <p>
                                    Suppliers
                                </p>

                            </a>

                        </li>



                        <!-- Purchases -->

                        <li class="nav-item">

                            <a asp-controller="Purchase"
                               asp-action="Index"
                               class="nav-link">

                                <i class="nav-icon fas fa-cart-shopping"></i>

                                <p>
                                    Purchases
                                </p>

                            </a>

                        </li>



                        <!-- ========================= -->
                        <!-- SALES -->
                        <!-- ========================= -->

                        <li class="nav-header">

                            SALES

                        </li>



                        <!-- Sales -->

                        <li class="nav-item">

                            <a asp-controller="Sale"
                               asp-action="Index"
                               class="nav-link">

                                <i class="nav-icon fas fa-receipt"></i>

                                <p>
                                    Sales
                                </p>

                            </a>

                        </li>



                        <!-- New Sale -->

                        <li class="nav-item">

                            <a asp-controller="Sale"
                               asp-action="Create"
                               class="nav-link">

                                <i class="nav-icon fas fa-plus-circle"></i>

                                <p>
                                    New Sale
                                </p>

                            </a>

                        </li>



                        <!-- ========================= -->
                        <!-- ADMINISTRATION -->
                        <!-- ========================= -->

                        @if (User.IsInRole("Admin"))
                        {

                            <li class="nav-header">

                                ADMINISTRATION

                            </li>



                            <!-- Register User -->

                            <li class="nav-item">

                                <a asp-area="Identity"
                                   asp-page="/Account/Register"
                                   class="nav-link">

                                    <i class="nav-icon fas fa-user-plus"></i>

                                    <p>
                                        Register User
                                    </p>

                                </a>

                            </li>



                            <!-- Account Settings -->

                            <li class="nav-item">

                                <a asp-area="Identity"
                                   asp-page="/Account/Manage/Index"
                                   class="nav-link">

                                    <i class="nav-icon fas fa-user-gear"></i>

                                    <p>
                                        Account Settings
                                    </p>

                                </a>

                            </li>

                        }


                    </ul>

                </nav>

            </div>

        </aside>



        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->

        <main class="app-main">


            <!-- Page Header -->

            <div class="app-content-header">

                <div class="container-fluid">

                    <div class="row">

                        <div class="col-sm-6">

                            <h3 class="mb-0">

                                @ViewData["Title"]

                            </h3>

                        </div>

                    </div>

                </div>

            </div>



            <!-- Page Content -->

            <div class="app-content">

                <div class="container-fluid">

                    @RenderBody()

                </div>

            </div>


        </main>



        <!-- ================================================= -->
        <!-- FOOTER -->
        <!-- ================================================= -->

        <footer class="app-footer">

            <strong>

                &copy; 2026 EnigmaStock.

            </strong>

            All rights reserved.

        </footer>


    </div>



    <!-- ================================================= -->
    <!-- SCRIPTS -->
    <!-- ================================================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>


    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    <script src="https://cdn.jsdelivr.net/npm/admin-lte@4.9.1/dist/js/adminlte.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>


    @await RenderSectionAsync("Scripts", required: false)


</body>

</html>