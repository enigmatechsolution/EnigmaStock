<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EnigmaStock</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EnigmaStock.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">

                <!--Application Name -->
                <a class="navbar-brand fw-bold"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    EnigmaStock
                </a>


                <!--Mobile Menu Button-->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigator">

                    <span class="navbar-toggler-icon"></span>

                </button>



                <!-- main navigation-->
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <!--Dashboard-->
                        <li class="nav-item">
                            <a class="nav-item" asp-area="" asp-controller="Home" asp-action="Index">
                                Dashboard
                            </a>
                        </li>



                        <!--Inventory dropdown-->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Inventory</a>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Category" asp-action="Index">Categories </a>
                                </li>

                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Product" asp-action="Index">Products</a>
                                </li>

                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="StockMovement" asp-action="Index">Stock Movements</a>
                                </li>
                            </ul>
                        </li>



                        <!--Procurement dropdown-->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Procurement</a>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Supplier" asp-action="Index">Suppliers</a>
                                </li>

                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Purchase" asp-action="Index">Purchases</a>
                                </li>
                            </ul>
                        </li>



                        <!--Sales dropdown-->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Sales</a>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Sale" asp-action="Index">Sales</a>
                                </li>

                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Sale" asp-action="Create">Create New Sale</a>
                                </li>
                            </ul>
                        </li>


                        <!--Administration: Admin users only-->
                        @if (User.IsInRole("Admin"))

                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Administration</a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-page="/Account/Register">Register User</a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-page="/Account/Manage/Index">Account Settings</a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <!--Login, register, username and logout-->
                    <partial name="_LoginPartial" />

                </div>
            </div>
        </nav>
    </header>


    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - EnigmaStock - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
