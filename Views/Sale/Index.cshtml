@using EnigmaStock.Models
@model List<Sale>



    <div class="container">
        <div class="row pt-4">
            <div class="col-6">
                <h2 class="text-primary">Sales</h2>

            </div>
            <div class="col-6 text-end">
                <a asp-controller="Sale" asp-action="Create" class="btn btn-primary">Create New Sale</a>

            </div>

        </div>
        <br />

        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Invoice Number</th>
                    <th>Customer</th>
                    <th>Sale Date</th>
                <th>Total</th>
                <th>Status</th>
                <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach(var item in Model)
            {
                var total = item.saleItems.Sum(si => si.Quantity * si.SellingPrice);
                <tr>
                    <td>@item.InvoiceNumber</td>
                    <td>@item.CustomerName</td>
                    <td>@item.SaleDate.ToString("dd/MM/yyyy")</td>
                    <td>₦@total.ToString("N2")</td>
                    <td>@item.Status</td>

                    <td> <a asp-controller="Sale" asp-action="Details" asp-route-id="@item.Id" class="btn btn-secondary">Details</a></td>
                </tr>
            }
        </tbody>

        </table>


    </div>