@using EnigmaStock.Models
@model Sale

<div class="container">

    <div class="row">
        <div class="col-6">
            <h2 class="text-primary">Sale Details</h2>

        </div>

        <div class="col-6">
            <a asp-controller="Sale" asp-action="AddItem" asp-route-saleid="@Model.Id" class="btn btn-primary">Add Item</a>

        </div>
    </div>

    <br />

    <div class="row mb-4">

        <div class="col-md-6">
            <p><strong>Invoice Number - </strong> @Model.InvoiceNumber</p>
            <p><strong>Sale Date - </strong>@Model.SaleDate</p>
        </div>
      

        <div class="col-md-6">
            <p><strong>Customer Name -</strong> @Model.CustomerName</p>
            <p><strong>Customer Phone -</strong>@Model.CustomerPhone</p>
            <p>
                Status: 
                @if(Model.Status=="Pending")
                {
                    <span class="badge bg-warning text-dark">Pending</span>
                }
                else if (Model.Status=="Completed")
                {
                    <span class="badge bg-success">Completed</span>
                }
            </p>
            @if (Model.Status == "Pending")
            {
                <div class="d-flex gap-2">

                    
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit sale</a>
                <form asp-action="CompleteSale" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />

                    <button type="submit" class="btn btn-success">Complete Sale

                    </button>
                </form>

                <form asp-action="CancelSale" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-danger">Cancel Sale</button>
                </form>              
       
                </div>            
            }

           
            @if (Model.Status == "Completed")
            {
                <a asp-action="Invoice" asp-route-id="@Model.Id" class="btn btn-primary">View Invoice</a>
            }

            @if (Model.Status == "Cancelled")
            {
                <form asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete this cancelled sale?');">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-danger">Delete Cancelled Sale</button>
                </form>
            }

            </div>

    <h4>Item Sold</h4>
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Product</th>
                <th>Quantity</th>
                <th>Selling Price (NGN)</th>
                <th>Total</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.saleItems )
            {
                <tr>
                    <td>@item.Product?.Name</td>
                    <td>@item.Quantity</td>
                    <td>@item.SellingPrice.ToString("N2")</td>
                    <td>₦@((item.Quantity * item.SellingPrice).ToString("N2"))</td>
                    <td> <form asp-action="RemoveItem" method="post">
                        <input type="hidden" name="id" value="@item.Id"/>
                        <button type="submit" class="btn btn-danger">Remove Item</button>
                    </form></td>
                </tr>
            }

        </tbody>


    </table>

    <div class="row">
        <div class="col-12 text-end">
                <h4>
                   Grand Total= ₦@(Model.saleItems
                  .Sum(Item => Item.Quantity * Item.SellingPrice).ToString("N2"))

              </h4>
        </div>
    </div>

</div>
</div>