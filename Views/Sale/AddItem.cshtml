@using EnigmaStock.Models
@model SaleItem




<div class="container mt-4">
    <div class="row">
        <div class="col-6">
            <h2>Add Item to Sale</h2>

        </div>
   </div>

   <hr />
   <form method="post">

       <input asp-for="SaleId" type="hidden"/>


       <div class="mb-3">
           <label asp-for="ProductId" class="form-control">Product Name</label>
           <select asp-for="ProductId" class="form-control">
               <option value="">...Select Product...</option>

               @foreach (var product in ViewBag.Products)

                        {
                    <option value="@product.Id">@product.Name - ₦@product.SellingPrice.ToString("N2") </option>
                        }

           </select>
           <span asp-validation-for="ProductId" class="text-danger"></span>
                    
           <div class="mb-3">
               <label asp-for="Quantity" class="form-control"></label>
               <input asp-for="Quantity" class="form-control" type="number" min="1"/>
               <span asp-validation-for="Quantity" class="text-danger"></span>

           </div>

           <button type="submit" class="btn btn-primary">Add Item</button>
           <a asp-controller="Sale" asp-action="Details" asp-route-id="@Model.SaleId" class="btn btn-secondary">Back to Sale</a>
       </div>

   </form>

</div>