@using EnigmaStock.Models
@model Sale


<div class="container mt-4">
    <div class="text-center mb-6">
        <h2>ENIGMATECH SOLUTIONS</h2>
        <h4>SALES INVOICE</h4>
    </div>

    <br />
    <div class="row mt-4">

    <div class="col-md-6">
        <p><strong>Invoice Number: </strong>@Model.InvoiceNumber</p>
            <p><strong>Sale Date: </strong>@Model.SaleDate</p>
            <p><strong>Status: </strong>@Model.Status</p>
        </div>

        <div class="col-md-6">
            <p><strong>Customer: </strong>@Model.CustomerName</p>
            <p><strong>Phone: </strong>@Model.CustomerPhone</p>
            <p><strong>Payment Method: </strong>@Model.PaymentMethod</p>
            
        </div>

    </div>

    <br />


    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Product</th>
                <th>Quantity</th>
                <th>Unit Price (NGN)</th>
                <th>Total</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.saleItems)
            {
                <tr>
                    <td>@item.Product?.Name</td>
                    <td>@item.Quantity</td>
                    <td>@item.SellingPrice.ToString("N2")</td>
                    <td>₦@((item.Quantity * item.SellingPrice).ToString("N2"))</td>
                </tr>
            }
        </tbody>

    </table>


    <div class="row">
        <div class="col-md-12 text-end">
            <h4>
                Grand Total:₦@(Model.saleItems
                .Sum(item => item.Quantity * item.SellingPrice).ToString("N2"))
            </h4>
       </div>
    </div>


    <div class="text-center mt-5">
        <p>Thank you for your patronage</p>
    </div>

    <div class="text-center mt-5">
        <button onclick="window.print()" class="btn btn-primary">Print Invoice

        </button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Back to Sale</a>
    </div>

</div>