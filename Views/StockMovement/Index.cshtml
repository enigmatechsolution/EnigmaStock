@using EnigmaStock.Models;
@model List<StockMovement>

    <div class="container p-3">


        <div class="row pt-4">
            <div class="col-6">
                <h2 class="text-primary">Stock Movement History</h2>

            </div>
        </div>

        <br />

        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Quantity</th>
                    <th>Movement Type</th>
                    <th>Date</th>
                    <th>Note</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var movement in Model)
            {
                <tr>
                    <td>@movement.Product?.Name</td>
                    <td>@movement.Quantity</td>
                    <td>@movement.MovementType</td>
                    <td>@movement.Date.ToString("dd/MM/yyyy  HH:mm")</td>
                    <td>@movement.Note</td>
                </tr>
            }
        </tbody>


        </table>

    </div>
