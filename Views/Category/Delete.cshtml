@model Category;
@using EnigmaStock.Models;

<form method="post" asp-action="Deletepost">
    <div class="border p-3 mt-4">
    <div class="row pb-2">
            <h2 class="text-primary">Delete Category</h2>
            <hr/>
    </div>
    </div>
   
    <div class="mb-3">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" disabled/>

    </div>
    <div>
            <div class="mb-3">
                <label asp-for="DisplayOrder"></label>
                <input asp-for="DisplayOrder" class="form-control" disabled />

    </div>
    <input type="hidden" asp-for="Id" />
    
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-controller="Category" asp-action="Delete" class="btn btn-secondary">Back to list</a>
    </div>
</form>